{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify_on_stop.py",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/verify.sh)",
      "Bash(scripts/verify.sh --full)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm --filter server test:*)",
      "Bash(pnpm --filter server db:migrate)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(docker compose ps)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Write(**/.claude/settings.json)",
      "Write(**/.claude/settings.local.json)",
      "Edit(**/.git/**)",
      "Write(**/.git/**)",
      "Edit(**/.githooks/**)",
      "Write(**/.githooks/**)",
      "Edit(//**/.git/config)",
      "Write(//**/.git/config)",
      "Edit(//**/.git/hooks/**)",
      "Write(//**/.git/hooks/**)",
      "Edit(//**/.git/refs/notes/**)",
      "Write(//**/.git/refs/notes/**)",
      "Edit(//**/.git/packed-refs)",
      "Write(//**/.git/packed-refs)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowRead": [
        "apps/server/.env"
      ],
      "allowWrite": [
        "~/Library/pnpm/store"
      ],
      "denyWrite": [
        ".githooks/",
        ".git/config",
        ".git/hooks/",
        ".git/refs/notes/",
        ".git/packed-refs",
        ".claude/worktrees/*/.claude/hooks/",
        ".claude/worktrees/*/.claude/skills/",
        ".claude/worktrees/*/.claude/settings.json",
        ".claude/worktrees/*/.githooks/"
      ]
    },
    "excludedCommands": [
      "git push *",
      "git fetch *",
      "git pull *",
      "gh *",
      "docker compose *",
      "scripts/worktree.sh *",
      "scripts/review-status.sh *"
    ]
  }
}
