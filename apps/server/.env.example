DATABASE_URL=postgresql://assistant:assistant@localhost:5432/assistant
# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
PORT=3001
# OpenAI, called through the Vercel AI SDK (ADR 003). The key is never committed.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Inngest (ADR 004). 1 = talk to the local Dev Server (npx inngest-cli@latest dev); no keys needed.
INNGEST_DEV=1
