{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".github/workflows/**"
  ],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "lint": {},
    "typecheck": {},
    "test": { "env": ["DATABASE_URL"] }
  }
}
